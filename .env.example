# Copy to .env and fill in. NEVER commit a real key (.env is git-ignored).

# LLM provider: "mock" (offline, no key) or "meta" (Meta Model API)
LLM_MODE=mock

# Meta Model API — get a key at https://dev.meta.ai (API keys; shown once)
MODEL_API_KEY=
# OpenAI-compatible base URL of the Meta Model API
META_API_BASE=https://api.meta.ai/v1
# Model: muse-spark-1.3 (recommended) | muse-spark-1.3-contributor | muse-wonder-1.0
META_MODEL=muse-spark-1.3

# Market data: "mock" (synthetic, offline) or "yfinance" (free, real)
DATA_MODE=mock
