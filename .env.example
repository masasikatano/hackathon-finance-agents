# Copy to .env and fill in. NEVER commit a real key (.env is git-ignored).

# LLM provider: "mock" (offline, no key), "meta" (Meta Model API — the
# primary provider; the hackathon submission runs on this) or "groq"
# (Groq free tier — DEVELOPMENT stand-in only, see README)
LLM_MODE=mock

# Meta Model API — get a key at https://dev.meta.ai (API keys; shown once)
MODEL_API_KEY=
# OpenAI-compatible base URL of the Meta Model API
META_API_BASE=https://api.meta.ai/v1
# Model: muse-spark-1.3 (recommended) | muse-spark-1.3-contributor | muse-wonder-1.0
META_MODEL=muse-spark-1.3

# Groq free tier (DEVELOPMENT ONLY — not the Meta Model API) — get a
# free key at https://console.groq.com (API Keys; no card required)
GROQ_API_KEY=
# OpenAI-compatible base URL of the Groq API
GROQ_API_BASE=https://api.groq.com/openai/v1
# Default free-tier model. The Groq free lineup changes often — check
# console.groq.com for the current free list before a run.
# Alternatives verified on the author's free account (2026-10-30):
# openai/gpt-oss-20b, qwen/qwen3.8-27b (no Llama chat models)
GROQ_MODEL=openai/gpt-oss-120b

# Market data: "mock" (synthetic, offline) or "yfinance" (free, real)
DATA_MODE=mock
